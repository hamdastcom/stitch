# Vite mode file used only by `npm run apk:myket`.
# Loaded on top of `.env`, so only the Myket-specific overrides go here.

# Switches the in-app purchase flow from the Zibal web gateway to Myket
# in-app billing. Any other value (or a missing var) keeps Zibal.
VITE_DISTRIBUTION=myket

# Production API for the store build — must NOT be localhost.
# apiClient appends "/api", so requests land on https://stage.api.hamdast.com/api/...
VITE_API_URL=https://api.hamdast.com
