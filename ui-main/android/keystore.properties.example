# کپی کن به android/keystore.properties و مقادیر کیستور خودت رو بذار.
# ساخت کیستور (یک‌بار، و حتماً بکاپ بگیر — گم بشه دیگه نمی‌تونی آپدیت بدی):
#
#   keytool -genkey -v -keystore hamdast-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias hamdast
#
# storeFile مسیرش نسبت به پوشه android/app است (یا مسیر مطلق بده).

storeFile=../hamdast-release.jks
storePassword=
keyAlias=hamdast
keyPassword=
